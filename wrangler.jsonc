{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solarhome",
  "compatibility_date": "2026-10-10",
  "main": "worker/proxy.ts",
  // Build the site before every deploy, so `wrangler deploy` never uploads an old dist.
  "build": {
    "command": "npm run build"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
